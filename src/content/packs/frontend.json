        "lines": [
          "export function QuoteLineItems({ items, onRemove, onSaveNote }: Props) {",
          "  return (",
          "    <ul className=\"line-items\">",
          "      {items.map((item, index) => (",
          "        <LineItemRow key={index} item={item} onRemove={onRemove} onSaveNote={onSaveNote} />",
          "      ))}",
          "    </ul>",
          "  );",
          "}",
          "",
          "function LineItemRow({ item, onRemove, onSaveNote }: RowProps) {",
          "  const [draft, setDraft] = useState(item.note ?? \"\");",
          "",
          "  return (",
          "    <li className=\"line-item\">",
          "      <span className=\"line-item__sku\">{item.sku}</span>",
          "      <textarea value={draft} onChange={(e) => setDraft(e.target.value)} />",
          "      <button type=\"button\" onClick={() => onSaveNote(item.id, draft)}>Save note</button>",
          "      <button type=\"button\" onClick={() => onRemove(item.id)}>Remove</button>",
          "    </li>",
          "  );",
          "}"
        ]
      }
    ],
    "question": "Which line moves B’s draft onto item C?",
    "answer": {
      "evidence": 1,
      "line": 4
    },
    "explanation": {
      "cause": "Rows keyed by array index, so React reuses B’s row state for C after A is removed",
      "why": "React matches children by key. Removing A shifts every item up one index, so the component that held key 1 (B’s row, with B’s draft in useState) now receives item C as props. Its state survives, Save sends C’s id with B’s text. key={item.id} keeps each row’s state with its item.",
      "tell": "The SKU label updates (it reads props) but the draft doesn’t (it’s state) — the signature of component state staying at a position while data moves under it."
    },
    "source": {
      "title": "React: Rendering Lists — Keeping list items in order with key",
      "url": "https://react.dev/learn/rendering-lists"
    }
