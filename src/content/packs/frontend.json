        "language": "ts",
        "startLine": 6,
        "lines": [
          "export function useOrderStatus(orderId: string): OrderStatus | null {",
          "  const [status, setStatus] = useState<OrderStatus | null>(null);",
          "",
          "  useEffect(() => {",
          "    let cancelled = false;",
          "",
          "    async function poll() {",
          "      const res = await fetch(`/api/orders/${orderId}/status`);",
          "      if (!res.ok) return;",
          "      const body: { status: OrderStatus } = await res.json();",
          "      if (!cancelled) setStatus(body.status);",
          "    }",
          "",
          "    poll();",
          "    const timer = setInterval(poll, 5000);",
          "    return () => {",
          "      cancelled = true;",
          "      clearInterval(timer);",
          "    };",
          "  }, []);",
          "",
          "  return status;",
          "}"
        ]
      }
    ],
    "question": "Which line makes the page show the previous order’s status?",
    "answer": {
      "evidence": 1,
      "line": 19
    },
    "explanation": {
      "cause": "Empty deps array: the effect never re-runs for a new orderId, so it polls the old order",
      "why": "The router reuses the mounted OrderPage across orderIds, so only props change. With [] the effect ran once and its poll closure captured orderId=A1042 forever; the interval keeps fetching that order and setting its status on the A1077 page. Listing [orderId] tears down the old interval and starts a new one.",
      "tell": "After the route changes to A1077 with no remount, requests keep going to A1042 on the same 5s cadence — a closure that never saw the new id."
    },
    "source": {
      "title": "React: Removing Effect Dependencies",
      "url": "https://react.dev/learn/removing-effect-dependencies"
    }
