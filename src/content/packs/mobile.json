        "lines": [
          "struct OrderStatusViewModel {",
          "    let title: String",
          "    let etaText: String",
          "    let isLate: Bool",
          "",
          "    private static let isoFormatter = ISO8601DateFormatter()",
          "    private static let etaFormatter: DateFormatter = {",
          "        let formatter = DateFormatter()",
          "        formatter.timeStyle = .short",
          "        return formatter",
          "    }()",
          "",
          "    init(order: Order, now: Date = Date()) {",
          "        let eta = Self.isoFormatter.date(from: order.estimatedDelivery)!",
          "        title = order.status.localizedTitle",
