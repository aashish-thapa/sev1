          "    private let host = \"img.partnercdn.example\"",
          "",
          "    func bannerURL(for promo: Promo, scale: CGFloat) -> URL? {",
          "        var components = URLComponents()",
          "        components.scheme = \"http\"",
          "        components.host = host",
          "        components.path = \"/banners/\\(promo.partnerID)/\\(promo.assetID).jpg\"",
          "        components.queryItems = [",
          "            URLQueryItem(name: \"w\", value: String(Int(promo.width * scale))),",
