          }
        ]
      },
      {
        "type": "facts",
        "label": "Triage notes",
        "items": [
          {
            "key": "Crashing thread",
            "value": "URLSession delegate queue, not com.apple.main-thread"
          },
          {
            "key": "Debug repro",
            "value": "Main Thread Checker: UI API called on a background thread: -[UILabel setText:]"
          },
          {
            "key": "OrderAPIClient",
            "value": "calls completion on the URLSession delegate queue"
          },
          {
            "key": "9.5.0 change",
            "value": "status refresh moved from Combine .receive(on:) to a callback"
          }
        ]
      },
      {
        "type": "code",
        "label": "OrderTrackingViewController.swift",
        "language": "swift",
        "startLine": 31,
        "lines": [
          "final class OrderTrackingViewController: UIViewController {",
          "    @IBOutlet private var statusLabel: UILabel!",
          "    @IBOutlet private var retryBanner: UIView!",
          "    private let client = OrderAPIClient.shared",
          "    private var lastStatus: OrderStatus?",
          "    var orderID: Order.ID?",
          "",
          "    func refreshStatus() {",
          "        guard let orderID else { return }",
          "        client.fetchStatus(orderID: orderID) { [weak self] result in",
          "            guard let self else { return }",
          "            switch result {",
          "            case .success(let status):",
          "                self.lastStatus = status",
          "                Analytics.track(.orderStatusViewed(status.rawValue))",
          "                self.statusLabel.text = status.localizedTitle",
          "            case .failure(let error):",
          "                Logger.orders.error(\"status refresh failed: \\(error.localizedDescription)\")",
          "                DispatchQueue.main.async {",
          "                    self.retryBanner.isHidden = false",
          "                }",
          "            }",
          "        }",
          "    }"
        ]
      }
    ],
    "question": "Tap the line that crashes the app.",
    "answer": {
      "evidence": 2,
      "line": 15
    },
    "explanation": {
      "cause": "The success branch sets a UILabel's text from the URLSession background queue",
      "why": "UIKit is main-thread-only. Setting statusLabel.text invalidates Auto Layout, and touching the layout engine off the main thread after the main thread has used it raises NSInternalInconsistencyException. The failure branch hops to the main queue; the success branch was never wrapped when Combine's .receive(on:) went away.",
      "tell": "Main Thread Checker names -[UILabel setText:], the crash is on the URLSession queue, and statusLabel.text is the only UI write in the callback outside DispatchQueue.main."
    }
  },
