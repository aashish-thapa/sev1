    "id": "sec-mass-assignment-role-from-body",
    "kind": "find-line",
    "topic": "security",
    "difficulty": 2,
    "alert": {
      "service": "accounts-api",
      "title": "Audit: user.role changed member→admin with no admin actor",
      "severity": "SEV1",
      "firedAt": "03:17"
    },
    "evidence": [
      {
        "type": "code",
        "label": "handlers/profile.ts",
        "language": "ts",
        "startLine": 9,
        "lines": [
          "const ProfilePatch = z.object({",
          "  displayName: z.string().min(1).max(64).optional(),",
          "  avatarUrl: z.string().url().optional(),",
          "  timezone: z.string().max(64).optional(),",
          "});",
          "",
          "export async function updateProfile(req: Request, res: Response) {",
          "  const userId = req.session.userId;",
          "  if (!userId) return res.status(401).end();",
          "",
          "  const parsed = ProfilePatch.safeParse(req.body);",
          "  if (!parsed.success) {",
          "    return res.status(422).json({ errors: parsed.error.flatten() });",
          "  }",
          "  const user = await prisma.user.update({",
          "    where: { id: userId },",
          "    data: { ...req.body, updatedAt: new Date() },",
          "    select: { id: true, displayName: true, avatarUrl: true, role: true },",
          "  });",
          "  return res.json(user);",
          "}"
        ]
      },
      {
        "type": "log",
        "label": "accounts-api audit",
        "lines": [
          {
            "ts": "03:16:40",
            "level": "INFO",
            "source": "accounts-api",
            "text": "PATCH /api/me 200 user=u_77120 fields=[displayName,timezone]"
          },
          {
            "ts": "03:16:58",
            "level": "INFO",
            "source": "accounts-api",
            "text": "PATCH /api/me 200 user=u_77120 fields=[displayName,role]"
          },
          {
            "ts": "03:16:58",
            "level": "WARN",
            "source": "audit",
            "text": "user.role u_77120 member -> admin actor=u_77120 via=PATCH /api/me"
          },
          {
            "ts": "03:17:22",
            "level": "INFO",
            "source": "accounts-api",
            "text": "GET /admin/users?limit=500 200 user=u_77120"
          }
        ]
      }
    ],
    "question": "Tap the line that let a member make themselves admin.",
    "answer": {
      "evidence": 0,
      "line": 16
    },
    "explanation": {
      "cause": "The update spreads raw req.body into Prisma instead of the validated parsed.data.",
      "why": "Zod objects strip unknown keys, so parsed.data could never contain role — but it is never used. The raw body goes straight to prisma.user.update, and role is a real column, so Prisma accepts it. That is mass assignment. Fix: `data: { ...parsed.data, updatedAt: new Date() }`.",
      "tell": "Validation passes because extra keys aren't errors, yet the audit shows role written from PATCH /api/me — a field the schema never lists."
    },
    "source": {
      "title": "OWASP Mass Assignment Cheat Sheet",
      "url": "https://cheatsheetseries.owasp.org/cheatsheets/Mass_Assignment_Cheat_Sheet.html"
    }
  },
