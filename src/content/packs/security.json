  {
    "id": "sec-sqli-fstring-status-filter",
    "kind": "find-line",
    "topic": "security",
    "difficulty": 1,
    "alert": {
      "service": "orders-api",
      "title": "Bug bounty #4471: other customers' orders visible via search",
      "severity": "SEV1",
      "firedAt": "14:22"
    },
    "evidence": [
      {
        "type": "code",
        "label": "orders/search.py",
        "language": "python",
        "startLine": 38,
        "lines": [
          "@bp.get(\"/api/orders/search\")",
          "@login_required",
          "def search_orders():",
          "    customer_id = current_user.customer_id",
          "    status = request.args.get(\"status\", \"open\")",
          "    sort = SORT_COLUMNS.get(request.args.get(\"sort\"), \"created_at\")",
          "    limit = min(int(request.args.get(\"limit\", 50)), 200)",
          "    sql = (",
          "        \"SELECT id, total_cents, status, created_at FROM orders \"",
          "        f\"WHERE customer_id = %s AND status = '{status}' \"",
          "        f\"ORDER BY {sort} DESC LIMIT %s\"",
          "    )",
          "    with db.cursor() as cur:",
          "        cur.execute(sql, (customer_id, limit))",
          "        rows = cur.fetchall()",
          "    return jsonify([serialize_order(r) for r in rows])"
        ]
      },
      {
        "type": "log",
        "label": "nginx access log (orders-api)",
        "lines": [
          {
            "ts": "14:03:11",
            "level": "INFO",
            "source": "nginx",
            "text": "GET /api/orders/search?status=shipped&sort=total 200 1840 \"Mozilla/5.0\""
          },
          {
            "ts": "14:05:47",
            "level": "INFO",
            "source": "nginx",
            "text": "GET /api/orders/search?status=open%27%20OR%201%3D1--&limit=200 200 48211 \"curl/8.5.0\""
          },
          {
            "ts": "14:06:02",
            "level": "INFO",
            "source": "nginx",
            "text": "GET /api/orders/search?sort=created_at%3BDROP 200 912 \"curl/8.5.0\""
          }
        ]
      }
    ],
    "question": "Tap the line that lets the researcher read every customer's orders.",
    "answer": {
      "evidence": 0,
      "line": 9
    },
    "explanation": {
      "cause": "status is interpolated into the SQL with an f-string instead of bound as a parameter.",
      "why": "`' OR 1=1--` closes the quote, ORs the customer filter away and comments out the rest, so the query returns all orders. customer_id and limit are bound safely; sort only ever comes from the SORT_COLUMNS allowlist. Fix: `status = %s` and pass status in the params tuple.",
      "tell": "The sort injection attempt returns a tiny normal response (allowlisted), while the quote-breaking status payload returns 48 KB: only the status value reaches the SQL text."
    },
    "source": {
      "title": "OWASP SQL Injection Prevention Cheat Sheet",
      "url": "https://cheatsheetseries.owasp.org/cheatsheets/SQL_Injection_Prevention_Cheat_Sheet.html"
    }
  },
