// Cloudflare Workers (free plan): the built site, one Durable Object per war room, D1 for accounts.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sev1",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Sockets and the API must reach the worker; the SPA fallback would otherwise answer them with index.html.
    "run_worker_first": ["/rooms", "/api/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "RoomObject" },
      // One instance, the public room list the lobby reads.
      { "name": "DIRECTORY", "class_name": "DirectoryObject" }
    ]
  },
  // The free plan only offers SQLite-backed Durable Objects.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RoomObject"] },
    { "tag": "v2", "new_sqlite_classes": ["DirectoryObject"] }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sev1",
      "database_id": "0f4048f4-4678-42b5-af04-3eba47b7697a",
      "migrations_dir": "worker/migrations"
    }
  ],
  // Billing reads STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, STRIPE_PRICE_PRO_MONTHLY and STRIPE_PRICE_PRO_YEARLY, all set
  // with `wrangler secret put` (secrets survive deploys; config vars would overwrite them). Until all four exist, /api/billing answers 503.
  "observability": { "enabled": true },
  // 8787 is the Node room server's; the Vite dev server proxies /api here.
  "dev": { "port": 8790 }
}
